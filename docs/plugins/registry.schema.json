{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pets.example/schemas/plugin-registry-v1.json",
  "title": "Agent Pets plugin registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-TW", "en-US"],
      "properties": {
        "zh-TW": { "type": "string", "minLength": 1, "maxLength": 48 },
        "en-US": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-TW", "en-US"],
      "properties": {
        "zh-TW": { "type": "string", "minLength": 1, "maxLength": 200 },
        "en-US": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "apiVersion", "url", "sha256", "size", "publishedAt"],
      "properties": {
        "version": { "type": "string", "maxLength": 100, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
        "apiVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3})$" },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://(raw\\.githubusercontent\\.com|github\\.com|objects\\.githubusercontent\\.com|release-assets\\.githubusercontent\\.com)(:443)?/" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "author", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?!_host$|_shared$)[a-z0-9-]{3,48}$" },
        "name": { "$ref": "#/$defs/localizedName" },
        "description": {
          "allOf": [
            { "$ref": "#/$defs/localizedText" },
            { "properties": { "zh-TW": { "maxLength": 200 }, "en-US": { "maxLength": 200 } } }
          ]
        },
        "author": { "type": "string", "minLength": 1, "maxLength": 64 },
        "homepage": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "publicKeyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    }
  }
}
