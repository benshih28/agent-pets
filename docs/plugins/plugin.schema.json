        },
        "text": {
          "$ref": "#/$defs/panelThemeColor"
        },
        "textMuted": {
          "$ref": "#/$defs/panelThemeColor"
        },
        "quotaFill": {
          "$ref": "#/$defs/panelThemeColor"
        },
        "quotaTrack": {
          "$ref": "#/$defs/panelThemeColor"
        },
        "quotaWarn": {
